# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.1.0 Project Minimal Configuration
#
# default:
CONFIG_IDF_TARGET="esp32s3"

# Custom partition table: adds the "model" SPIFFS partition ESP-SR packs its
# WakeNet/AFE model data into (components/wake_word, Task 5).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-S3R8 module on this board has 16MB flash (see design spec); the
# custom partition table above (nvs + 3M factory app + 5900K model) needs
# more than the 2/4MB ESP-IDF default.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ESP-SR (components/wake_word): select the "Hey,Kira" and "Hi,Wall,E"
# WakeNet9 models so esp_srmodel_filter(..., ESP_WN_PREFIX, "heykira"/
# "hiwalle") can find them packed into the "model" partition at build
# time. Two, not one:
# esp_afe_config_t has both wakenet_model_name (wakenet 1) and
# wakenet_model_name_2 (wakenet 2) for exactly this -- running two WakeNet
# models at once, distinguished at runtime by the detection result's
# wake_word_index (already logged in wake_word.c). All WakeNet models are
# CONFIG_SR_WN_* = n by default (see managed_components/espressif__esp-sr's
# Kconfig.projbuild) -- without this, the model partition would be built
# empty and wakenet_model_name/_2 would resolve to NULL at runtime. Each
# model is ~290KB (checked against the other options' file sizes) against a
# 5900KB "model" partition, so two together is not a size concern the way
# ESPDet's RAM footprint was (see camera_face_track's history).
#
# "Hey,Kira" + "Hi,Wall,E" (was "Jarvis" + "Alexa"; "Jarvis" + "Hey,GiGi"
# was tried first and rejected -- see below): confirmed on real hardware
# that pairing two WakeNet9 models only works if their internal hidden-
# layer size matches -- each model's _MODEL_INFO_ file encodes this in its
# name as "...h<N>..." (e.g. Hey,Kira and Hi,Wall,E are both "h12"; Jarvis
# and Alexa were both "h8"; Hey,GiGi is "h18" -- none of these three sizes
# interchange). Jarvis+Hey,GiGi crashed on every boot with `assert failed:
# model_detect_mfcc wakenet9_quantized.c:1008 (cq->n == model->layers[0]->n)`
# -- a real dimension mismatch inside the WakeNet library, not a config
# mistake -- and kept crash-looping since nothing about the (persisted,
# correct-looking) config changed between boots. Hey,Kira+Hi,Wall,E's
# matching "h12" avoids this.
CONFIG_SR_WN_WN9_HEYKIRA_TTS3=y
CONFIG_SR_WN_WN9_HIWALLE_TTS2=y

# network_provisioning (components/wifi_provisioning, Task 9): protocomm's
# security version 1 (X25519 handshake + proof-of-possession) is disabled by
# default -- only version 2 (SRP6a) ships enabled out of the box (see
# esp-idf/components/protocomm/Kconfig). Task 9 uses NETWORK_PROV_SECURITY_1
# per the brief, since it only needs a single shared proof-of-possession
# string (matching the Pi's hotspot_password model) rather than SRP6a's
# per-device salt/verifier provisioning story.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

# PSRAM was never enabled anywhere in this project despite this board's
# ESP32-S3R8 module having 8MB of Octal PSRAM in-package (see design spec) --
# a gap no task/review caught, since it's a chip/board-level setting that
# only breaks at runtime under memory pressure, not at compile time. Found
# on real hardware: wake_word_start() crashes (EXCCAUSE StoreProhibited)
# inside ESP-SR's AFE init, which does a heap_caps_malloc(..., MALLOC_CAP_SPIRAM)
# for its internal buffers (components/wake_word/wake_word.c already assumed
# PSRAM was available) -- without CONFIG_SPIRAM, that allocation has nowhere
# to come from and the library dereferences the resulting NULL.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# wifi_provisioning's "set_server_url" serial console (esp_console) needs
# to receive typed input, not just print log output. This chip's Kconfig
# default is primary console = UART0 (GPIO43/44) with USB-Serial-JTAG only
# as a SECONDARY console -- and a secondary console is always output-only
# (ESP-IDF's own console example warns about exactly this:
# "examples/system/console/basic/main/console_example_main.c"). This
# board's /dev/cu.usbmodemXXXX is the USB-Serial-JTAG peripheral, so with
# the stock default every command typed over that port was silently
# dropped -- confirmed on real hardware (esp_console_new_repl_stdio()
# started fine, printed its banner, then never responded to any input,
# not even "help"). Making USB-Serial-JTAG the PRIMARY console instead
# fixes it; UART0 was never used for anything else in this project, so no
# secondary console is needed.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# esp_websocket_client (components/server_client): found on real hardware,
# root-caused by reading uvicorn's actual Config defaults (ws_ping_interval
# =20.0, ws_ping_timeout=20.0 -- haro-server never overrides either) against
# server_client.c's own source -- every WebSocket session was being closed
# by the SERVER at a precise, repeated ~40s (20+20), not a network flake.
# Without this option, esp_websocket_client_send_with_exact_opcode() (every
# send in server_client.c) and the receive path that answers an incoming
# PING with a PONG (esp_websocket_client.c's "if a PING message received ->
# send out the PONG") share ONE lock (`client->lock`). server_client_send_
# camera_frame() sends a base64 JPEG from its own task every 500ms with NO
# timeout bound (portMAX_DELAY -- see NON_ORCHESTRATOR_SEND_TIMEOUT's
# comment in server_client.c for why that bound had to be removed in the
# first place, on this same slow network); while that send is in flight,
# the shared lock is held, so an incoming PING sitting in the TCP receive
# buffer can't even be parsed, let alone answered -- the PONG never goes
# out, and uvicorn kills the "unresponsive" connection at the 40s mark on a
# perfectly healthy link. This option gives sends their own `tx_lock`
# (esp_websocket_client's own Kconfig help text: "avoid the lock contention
# when send and receive data at the same time"), so a slow camera-frame
# write no longer blocks answering the server's keepalive.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y

# esp32-camera (components/camera_face_track): let the camera's DMA land
# directly in PSRAM instead of a ~30KB internal-RAM DMA bounce buffer
# (cam_hal logged "PSRAM DMA mode disabled ... dma_buffer_size: 30720").
# Found on real hardware (2026-09-23): after camera + AFE init, internal RAM
# was down to ~4-8KB free with the largest free block at 1344-1536 bytes,
# and every WiFi dynamic TX buffer allocation (1630 bytes,
# MALLOC_CAP_DMA|MALLOC_CAP_INTERNAL) failed as soon as audio streaming
# started after the wake word -- no TCP segment could be transmitted, the
# first audio-frame send blocked its full SEND_TIMEOUT_MS, and
# esp_websocket_client aborted the connection. RSSI was a healthy -65..-68
# dBm throughout; this was never a WiFi signal problem.
CONFIG_CAMERA_PSRAM_DMA=y

# Plain malloc() of more than 1KB goes to PSRAM, not internal RAM (IDF
# default: 16KB). Found on real hardware (2026-09-24): re-enabling camera
# frames, the base64-JSON frame string (~9.5KB) was allocated in internal
# RAM, dropping it to a 252-byte minimum with the largest free block at
# 1344 bytes -- below the 1630-byte WiFi TX buffer -- so frame sends stalled
# for 35s and the server dropped the connection (the same starvation
# CONFIG_CAMERA_PSRAM_DMA above fixed for audio). Streamed TTS audio chunks
# (~2.5KB each, up to ~1s queued) were headed for the same problem.
# Drivers that need DMA/internal memory request it with explicit caps, so
# they're unaffected.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
